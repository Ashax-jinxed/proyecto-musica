#!/bin/sh
# musica - buscar y reproducir audio de YouTube desde la terminal
# antiX 32 bits: /bin/sh (dash), sin arrays, sin fzf.
#
# Uso:
#   musica algo que quiero escuchar          -> busca y muestra 5 resultados
#   musica -r algo que quiero escuchar       -> modo radio (autoplay infinito)
#   musica -l                                -> muestra el historial
#   DEBUG=1 musica algo que quiero escuchar  -> modo diagnostico completo
#
# Dependencias: yt-dlp (con soporte quickjs), mplayer. Opcional: notify-send

VERSION="musica 2.2 (formato flexible + fallback de clientes)"
CACHE_DIR="$HOME/.cache/ytplay"
HIST="$CACHE_DIR/historial.log"
DEBUG_LOG="$CACHE_DIR/debug.log"
YTDLP="/home/ashax/.local/bin/yt-dlp"
QJS="/usr/local/bin/qjs"
JS='--js-runtimes quickjs'
DEBUG="${DEBUG:-0}"

mkdir -p "$CACHE_DIR"

TAB="$(printf '\t')"
RADIO=0

# ---- logging ----
dlog() {
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '[%s] %s\n' "$ts" "$*" >> "$DEBUG_LOG"
    if [ "$DEBUG" = "1" ]; then
        printf '[DEBUG] %s\n' "$*" >&2
    fi
}

log_session_start() {
    dlog "=== Nueva sesion ==="
    dlog "version: $VERSION"
    dlog "arquitectura: $(uname -m 2>/dev/null)"
    dlog "kernel: $(uname -r 2>/dev/null)"
    dlog "PATH: $PATH"
    dlog "directorio de trabajo: $(pwd)"
    dlog "CACHE_DIR: $CACHE_DIR"
    dlog "yt-dlp ruta: $YTDLP"
    dlog "yt-dlp version: $("$YTDLP" --version 2>&1)"
    if [ -x "$QJS" ]; then
        dlog "QuickJS disponible: si ($QJS)"
    else
        dlog "QuickJS disponible: no ($QJS no ejecutable)"
    fi
    dlog "mplayer version: $(mplayer -version 2>&1 | head -1)"
}

run_diagnostics() {
    dlog "--- Diagnostico del sistema ---"
    dlog "command -v yt-dlp: $(command -v yt-dlp 2>&1)"
    dlog "yt-dlp ruta configurada: $YTDLP"
    dlog "yt-dlp --version: $("$YTDLP" --version 2>&1)"
    dlog "command -v qjs: $(command -v qjs 2>&1)"
    dlog "qjs ruta configurada: $QJS"
    dlog "command -v mplayer: $(command -v mplayer 2>&1)"
    dlog "mplayer -version: $(mplayer -version 2>&1 | head -1)"
    dlog "uname -a: $(uname -a 2>&1)"
    dlog "file yt-dlp: $(file "$YTDLP" 2>&1)"
    dlog "file qjs: $(file "$QJS" 2>&1)"
}

log_session_start
[ "$DEBUG" = "1" ] && run_diagnostics

trap 'dlog "Sesion interrumpida por el usuario (INT/TERM)"; printf "\nSesion terminada.\n"; exit 0' INT TERM

# ---- flags ----
if [ "$1" = "-l" ]; then
    [ -f "$HIST" ] && tail -n 30 "$HIST" || echo "Sin historial todavia."
    exit 0
fi
if [ "$1" = "-r" ]; then
    RADIO=1
    shift
fi
if [ $# -eq 0 ]; then
    echo "Uso: musica [-r] termino de busqueda   |   musica -l (historial)"
    exit 1
fi

# ---- intenta la descarga con un player_client y un selector de formato dados ----
# No forzamos formato 251 ni dejamos que yt-dlp elija android_vr por defecto:
# usamos selector de formato flexible (bestaudio/best) y una lista ordenada de
# estrategias de player_client, registrando cada intento en debug.log.
download_with_client() {
    client="$1"
    fmt="$2"
    id="$3"
    url="https://www.youtube.com/watch?v=$id"
    out_tpl="$CACHE_DIR/${id}.%(ext)s"
    dl_out=$(mktemp)
    dl_err=$(mktemp)

    before_files=$(find "$CACHE_DIR" -maxdepth 1 -name "${id}.*" 2>/dev/null | tr '\n' ' ')
    dlog "Intento: player_client=$client, formato=$fmt"
    dlog "Archivos en CACHE_DIR antes (id=$id): ${before_files:-ninguno}"
    dlog "Comando: $YTDLP $JS -f \"$fmt\" --no-warnings --no-playlist --extractor-args \"youtube:player_client=$client\" --print \"%(format_id)s\" -o \"$out_tpl\" \"$url\""
    [ "$DEBUG" = "1" ] && echo "[DEBUG] Probando player_client=$client formato=$fmt" >&2

    "$YTDLP" $JS -f "$fmt" --no-warnings --no-playlist \
        --extractor-args "youtube:player_client=$client" \
        --print "%(format_id)s" \
        -o "$out_tpl" "$url" > "$dl_out" 2> "$dl_err"
    dl_rc=$?
    format_id=$(tail -n 1 "$dl_out" 2>/dev/null)
    after_files=$(find "$CACHE_DIR" -maxdepth 1 -name "${id}.*" 2>/dev/null | tr '\n' ' ')

    dlog "player_client=$client formato=$fmt -> codigo salida: $dl_rc, format_id resuelto: $format_id"
    dlog "stdout: $(cat "$dl_out")"
    dlog "stderr: $(cat "$dl_err")"
    dlog "Archivos en CACHE_DIR despues (id=$id): ${after_files:-ninguno}"

    if [ "$DEBUG" = "1" ]; then
        [ -s "$dl_out" ] && { echo "--- stdout ($client/$fmt) ---" >&2; cat "$dl_out" >&2; }
        [ -s "$dl_err" ] && { echo "--- stderr ($client/$fmt) ---" >&2; cat "$dl_err" >&2; }
    fi

    file=$(find "$CACHE_DIR" -maxdepth 1 -name "${id}.*" 2>/dev/null | head -1)
    if [ -n "$file" ]; then
        size=$(wc -c < "$file" 2>/dev/null | tr -d ' ')
        dlog "Archivo resultante: $file (tamano: ${size:-0} bytes)"
    fi

    if [ "$DEBUG" = "1" ]; then
        dlog "Temporales conservados: $dl_out $dl_err"
    else
        rm -f "$dl_out" "$dl_err"
    fi

    if [ -n "$file" ] && [ -s "$file" ] && [ "$dl_rc" -eq 0 ]; then
        dlog "EXITO con player_client=$client formato=$fmt (format_id=$format_id)"
        echo "$file"
        return 0
    fi
    return 1
}

# ---- inspecciona formatos disponibles cuando todas las estrategias normales fallan ----
inspect_formats() {
    id="$1"
    url="https://www.youtube.com/watch?v=$id"
    fmt_out=$(mktemp)
    fmt_err=$(mktemp)
    dlog "Inspeccionando formatos disponibles (yt-dlp -F) para id=$id"
    "$YTDLP" $JS --no-warnings --no-playlist -F \
        --extractor-args "youtube:player_client=default" "$url" > "$fmt_out" 2> "$fmt_err"
    fmt_rc=$?
    dlog "yt-dlp -F codigo salida: $fmt_rc"
    dlog "Formatos disponibles: $(cat "$fmt_out")"
    [ -s "$fmt_err" ] && dlog "stderr -F: $(cat "$fmt_err")"
    if [ "$DEBUG" = "1" ]; then
        echo "--- Formatos disponibles (yt-dlp -F) ---" >&2
        cat "$fmt_out" >&2
    fi
    rm -f "$fmt_out" "$fmt_err"
}

# ---- busca video en cache local, o lo descarga probando estrategias en orden ----
get_or_download() {
    id="$1"
    cached=$(find "$CACHE_DIR" -maxdepth 1 -name "${id}.*" 2>/dev/null | head -1)
    if [ -n "$cached" ]; then
        dlog "Usando archivo en cache: $cached"
        echo "$cached"
        return 0
    fi

    file=$(download_with_client "default,web_embedded" "bestaudio/best" "$id")
    if [ -n "$file" ]; then echo "$file"; return 0; fi
    dlog "Estrategia 1 (default,web_embedded / bestaudio-best) fallo, probando estrategia 2"

    file=$(download_with_client "default,-android_vr" "bestaudio/best" "$id")
    if [ -n "$file" ]; then echo "$file"; return 0; fi
    dlog "Estrategia 2 (default,-android_vr / bestaudio-best) fallo, probando estrategia 3"

    file=$(download_with_client "web_embedded,default" "bestaudio/best" "$id")
    if [ -n "$file" ]; then echo "$file"; return 0; fi
    dlog "Estrategia 3 (web_embedded,default / bestaudio-best) fallo, inspeccionando formatos disponibles"

    inspect_formats "$id"

    dlog "Probando fallback final: player_client=default, formato=best (archivo unico)"
    file=$(download_with_client "default" "best" "$id")
    if [ -n "$file" ]; then echo "$file"; return 0; fi

    ytdlp_ver=$("$YTDLP" --version 2>&1)
    echo "ERROR: no se pudo descargar el audio con ninguna estrategia probada." >&2
    echo "  (default+web_embedded, default sin android_vr, web_embedded+default, default/best)" >&2
    echo "yt-dlp instalado: $ytdlp_ver" >&2
    echo "Puede ser SABR, exigencia de PO token, o un extractor de YouTube desactualizado." >&2
    echo "Revisa $DEBUG_LOG (incluye la salida completa de 'yt-dlp -F')." >&2
    dlog "DESCARGA FALLIDA TOTAL para id=$id. yt-dlp version: $ytdlp_ver"
    return 1
}

# ---- reproduce un id: registra historial, notifica, descarga y reproduce ----
# Siempre reproduce desde archivo local descargado. Nunca entrega una URL
# temporal de googlevideo.com directamente a mplayer.
play_id() {
    id="$1"
    title="$2"
    dlog "ID seleccionado: $id"
    dlog "Titulo seleccionado: $title"
    printf "%s\t%s\n" "$(date '+%Y-%m-%d %H:%M')" "$title" >> "$HIST"
    command -v notify-send >/dev/null 2>&1 && notify-send "Reproduciendo" "$title" 2>/dev/null
    echo "-> $title"

    file=$(get_or_download "$id")
    dl_status=$?

    if [ "$dl_status" -ne 0 ] || [ -z "$file" ] || [ ! -s "$file" ]; then
        echo "ERROR: no se pudo obtener un archivo de audio valido para '$title'." >&2
        echo "Revisa $DEBUG_LOG para el detalle completo. Se omite esta pista." >&2
        dlog "Reproduccion abortada: archivo invalido o inexistente para id=$id"
        return 1
    fi

    mp_out=$(mktemp)
    mp_err=$(mktemp)
    dlog "Comando mplayer: mplayer -nolirc -really-quiet -cache 8192 \"$file\""
    [ "$DEBUG" = "1" ] && echo "[DEBUG] Reproduciendo archivo local: $file" >&2

    mplayer -nolirc -really-quiet -cache 8192 "$file" > "$mp_out" 2> "$mp_err"
    mp_rc=$?

    dlog "Codigo de salida mplayer: $mp_rc"
    dlog "stdout mplayer: $(cat "$mp_out")"
    dlog "stderr mplayer: $(cat "$mp_err")"

    if [ "$DEBUG" = "1" ]; then
        [ -s "$mp_out" ] && cat "$mp_out"
        [ -s "$mp_err" ] && cat "$mp_err" >&2
    fi
    if [ "$mp_rc" -ne 0 ]; then
        echo "ERROR: mplayer termino con codigo $mp_rc. Ver $DEBUG_LOG" >&2
    fi
    rm -f "$mp_out" "$mp_err"
}

# ---- siguiente track relacionado (mezcla RD de YouTube) para modo radio ----
next_related() {
    id="$1"
    rel_err=$(mktemp)
    result=$("$YTDLP" $JS --flat-playlist --no-warnings --print "%(id)s${TAB}%(title).60s" \
        "https://www.youtube.com/watch?v=${id}&list=RD${id}" 2> "$rel_err" | sed -n '2p')
    rel_rc=$?
    dlog "Comando relacionados (id=$id) codigo salida: $rel_rc"
    [ -s "$rel_err" ] && dlog "stderr relacionados: $(cat "$rel_err")"
    rm -f "$rel_err"
    echo "$result"
}

# ---- busqueda inicial: 5 resultados numerados ----
dlog "Termino de busqueda: $*"
tmpfile=$(mktemp)
search_err=$(mktemp)
dlog "Comando de busqueda: $YTDLP $JS --flat-playlist --no-warnings --print \"%(id)s<TAB>%(title).70s\" \"ytsearch5:$*\""
"$YTDLP" $JS --flat-playlist --no-warnings --print "%(id)s${TAB}%(title).70s" \
    "ytsearch5:$*" > "$tmpfile" 2> "$search_err"
search_rc=$?
dlog "Codigo de salida busqueda: $search_rc"
[ -s "$search_err" ] && dlog "stderr busqueda: $(cat "$search_err")"
if [ "$DEBUG" = "1" ] && [ -s "$search_err" ]; then
    echo "--- stderr busqueda ---" >&2
    cat "$search_err" >&2
fi
rm -f "$search_err"

n=0
while IFS="$TAB" read -r id title; do
    [ -z "$id" ] && continue
    n=$((n + 1))
    eval "id_$n=\"\$id\""
    eval "title_$n=\"\$title\""
    printf "%d) %s\n" "$n" "$title"
done < "$tmpfile"
rm -f "$tmpfile"

if [ "$n" -eq 0 ]; then
    echo "Sin resultados (codigo de salida busqueda: $search_rc). Ver $DEBUG_LOG" >&2
    exit 1
fi

printf "Elegi [1-%d] (Enter = 1): " "$n"
read -r choice
[ -z "$choice" ] && choice=1
eval "sel_id=\"\$id_$choice\""
eval "sel_title=\"\$title_$choice\""

# ---- reproduccion ----
play_id "$sel_id" "$sel_title"

if [ "$RADIO" -eq 1 ]; then
    cur_id="$sel_id"
    while true; do
        next=$(next_related "$cur_id")
        [ -z "$next" ] && { echo "No encontre mas relacionados."; break; }
        nid=$(echo "$next" | cut -f1)
        ntitle=$(echo "$next" | cut -f2)
        [ "$nid" = "$cur_id" ] && break
        play_id "$nid" "$ntitle"
        cur_id="$nid"
    done
fi
